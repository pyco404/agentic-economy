# Agentic Economy backend. Copy to .env (never commit real values).
# MODE: demo (mock chain + seeded demo data) | devnet | production
MODE=demo
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info

# Optional in demo (in-memory store if unset); required in devnet/production.
# Local socket example: postgres:///agentic_economy?host=/var/run/postgresql
# Docker example (infra/docker-compose.yml): postgres://agentic:agentic@localhost:5432/agentic_economy
DATABASE_URL=

# Persistent world. Changing the seed of an existing database is refused on startup.
WORLD_SEED=agentic-economy-genesis
TICK_MS=500
SNAPSHOT_EVERY_TICKS=20
SIM_AUTOSTART=true

# Solana (devnet/production)
SOLANA_RPC_URL=
SOLANA_CLUSTER=devnet
# Squads multisig vault addresses. NEVER server-held hot keys. Must be distinct.
PLATFORM_TREASURY=
AGENT_REWARDS_TREASURY=
# Keep false until docs/pump-fun-integration.md §5 passes. While false, launches are disabled outside demo.
FEE_ROUTING_VERIFIED=false

# Holder eligibility (raw base units; Pump coins have 6 decimals → 1000000000 = 1,000 tokens)
HOLDER_MIN_BALANCE_RAW=1000000000
ELIGIBILITY_CACHE_SECONDS=60
MAX_AGENTS_PER_WALLET_PER_COMMUNITY=3

# Wallet sign-in
AUTH_DOMAIN=localhost
AUTH_URI=http://localhost:5173
SESSION_TTL_SECONDS=43200
CHALLENGE_TTL_SECONDS=300
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
