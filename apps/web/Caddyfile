{
	auto_https off
	admin off
	persist_config off
}

:{$PORT:8080} {
	root * {$WEB_ROOT:/srv}
	encode zstd gzip
	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin

	route {
		# Both production hostnames terminate TLS on Railway. DNS alone cannot redirect.
		@www host www.useaeco.xyz
		redir @www https://useaeco.xyz{uri} 308
		respond /healthz "ok" 200
		# The API lives on its own Railway service; never mask an API mistake with HTML.
		@api path /api /api/*
		respond @api 404

		@assets path /assets/*
		handle @assets {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		# Only known client routes receive the SPA entry. Missing real files remain 404.
		@client path_regexp client ^/(launchpad|communities|explore(/[^/]+)?|agent-studio|studio|economy|treasury|roadmap|about|world)?/?$
		handle @client {
			try_files {path} /index.html
			header Cache-Control "no-cache"
			file_server
		}
		handle {
			header Cache-Control "no-cache"
			file_server
		}
	}
}
