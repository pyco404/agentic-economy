# Stage 1 — single Railway service "agentic-economy" (ROLE=all) + Railway Postgres.
# Paste into the service's Variables (RAW editor). ${{Postgres.DATABASE_URL}} is Railway reference syntax.
ROLE=all
MODE=devnet
DATABASE_URL=${{Postgres.DATABASE_URL}}
HOST=::
LOG_LEVEL=info
WORLD_SEED=agentic-economy-genesis
TICK_MS=500
SNAPSHOT_EVERY_TICKS=120
VIEW_EVERY_TICKS=2
STREAM_RETENTION_MINUTES=60
LEADER_RETRY_MS=2000
INDEXER_INTERVAL_MS=30000

# Solana — external RPC provider (Helius / Triton / QuickNode). Keep secret.
SOLANA_RPC_URL=
SOLANA_CLUSTER=devnet
# Squads multisig VAULT addresses (public keys only). The server never holds treasury keys.
PLATFORM_TREASURY=
AGENT_REWARDS_TREASURY=
# MUST stay false until apps/server/docs/pump-fun-integration.md §5 passes AND you approve. Launches stay disabled.
FEE_ROUTING_VERIFIED=false

HOLDER_MIN_BALANCE_RAW=1000000000
ELIGIBILITY_CACHE_SECONDS=60
# Demo house agents (POST /agents/house): per signed-in wallet, and city-wide.
HOUSE_AGENTS_PER_WALLET=5
HOUSE_AGENTS_MAX=60

# Wallet sign-in: your public API domain and the frontend origin(s).
AUTH_DOMAIN=api.example.com
AUTH_URI=https://app.example.com
CORS_ORIGINS=https://app.example.com
SESSION_TTL_SECONDS=43200
CHALLENGE_TTL_SECONDS=300
