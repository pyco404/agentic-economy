# Stage 2 — service "api" (public HTTP + WebSocket). Scale replicas freely (1..N).
ROLE=api
MODE=devnet
DATABASE_URL=${{Postgres.DATABASE_URL}}
HOST=::
LOG_LEVEL=info
WORLD_SEED=agentic-economy-genesis
TICK_MS=500
STREAM_RETENTION_MINUTES=60
SOLANA_RPC_URL=
SOLANA_CLUSTER=devnet
PLATFORM_TREASURY=
AGENT_REWARDS_TREASURY=
FEE_ROUTING_VERIFIED=false
HOLDER_MIN_BALANCE_RAW=1000000000
ELIGIBILITY_CACHE_SECONDS=60
MAX_AGENTS_PER_WALLET_PER_COMMUNITY=3
AUTH_DOMAIN=api.example.com
AUTH_URI=https://app.example.com
CORS_ORIGINS=https://app.example.com
SESSION_TTL_SECONDS=43200
CHALLENGE_TTL_SECONDS=300
