# Stage 2 — service "indexer" (private; no domain). 1 replica; a 2nd is a standby (lease) and never double-counts.
ROLE=indexer
MODE=devnet
DATABASE_URL=${{Postgres.DATABASE_URL}}
HOST=::
LOG_LEVEL=info
WORLD_SEED=agentic-economy-genesis
INDEXER_INTERVAL_MS=30000
SOLANA_RPC_URL=
SOLANA_CLUSTER=devnet
PLATFORM_TREASURY=
AGENT_REWARDS_TREASURY=
FEE_ROUTING_VERIFIED=false
