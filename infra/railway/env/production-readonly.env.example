# Reviewed production preparation only. Never reuse another environment's DATABASE_URL.
# Applying 001–004 to a new production database requires separate owner approval.
# Install provider credentials through Railway's backend Variables panel only.
MODE=production
ROLE=all
DATABASE_URL=${{Postgres.DATABASE_URL}}
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
WORLD_SEED=aeco-production-genesis
SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
PLATFORM_TREASURY=HmmnNqZbfUZ2YK4mWVLXEGTsAU2NUUAvFzLFxgdgKUT2
AGENT_REWARDS_TREASURY=GEDMCV4WXHCAnySqH4CWNh3NYBrDfAUb3t4BBVBWVnJi
AUTH_DOMAIN=useaeco.xyz
AUTH_URI=https://useaeco.xyz
CORS_ORIGINS=https://useaeco.xyz,https://www.useaeco.xyz
LAUNCH_REGISTRATION_COMMITMENT=finalized
PUMP_LAUNCH_LOOKUP_TABLE=33wnSGm8hPBd9omoa252NAY8JX5PWJngkTNJgzdvdEZr
# Only after the owner creates the official wallet-owned draft and the release is approved:
# PUMP_PREPARED_MINT_DRAFT_ID=<exact-existing-draft-UUID>
# This public binding is not an execution approval and never contains a keypair.
PUMP_LAUNCH_ENABLED=false
FEE_ROUTING_VERIFIED=false
MAINNET_LAUNCH_APPROVED=false
USDC_LAUNCH_ENABLED=false
# No treasury signer or payout service is configured.
# Backend-only PINATA_JWT and a dedicated HELIUS_API_KEY are installed separately.
# Frontend: VITE_API_URL=https://api.useaeco.xyz
# Frontend: VITE_WS_URL=wss://api.useaeco.xyz/api/v1/ws

# Official planned native mint, owner supplied; public address only, not a fee recipient.
# Preserve the exact prepared mint. Configure ONLY after its approved launch is verified.
# AECO_MINT=ZjUr8cr2fxQoBrv8zh4n752yQmcTFVgr3z5MgZeAeco
AECO_MINT_VERIFIED=false
AECO_COMMON_AGENTS_ENABLED=false
# Deployer remains 3pF1MM1PCg2tekM5KeWEDyT8LVKbVd7ia668NRAnYpAR, not a treasury.
# Never put private key bytes in this example or any repository file.
# Optional one-time AECO_VANITY_MINT_SECRET: owner-installed sealed variable on production backend only.
# Server co-signing never enables launch permissions; remove the secret after finalized creation.
