# Stage 2 — service "sim" (private; no domain). Runs 1 replica; a 2nd replica is a hot standby (never double-processes).
# No Solana or treasury variables: the simulation has no chain access by design.
ROLE=sim
MODE=devnet
DATABASE_URL=${{Postgres.DATABASE_URL}}
HOST=::
LOG_LEVEL=info
WORLD_SEED=agentic-economy-genesis
TICK_MS=500
SNAPSHOT_EVERY_TICKS=120
VIEW_EVERY_TICKS=2
STREAM_RETENTION_MINUTES=60
LEADER_RETRY_MS=2000
